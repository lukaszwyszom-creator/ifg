{
  "expo": {
    "name": "IFG Mobile",
    "slug": "ifg-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "ifg",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "pl.ifg.mobile"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "http://127.0.0.1:8000"
    }
  }
}
