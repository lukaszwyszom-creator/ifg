# Wspólna konfiguracja skryptów deploy / diagnostyki DS723+.
# Edytuj tylko tutaj — pozostałe skrypty source'ują ten plik.

DS723_HOST=ds723
DS723_USER=zdalny_admin
DS723_PORT=32122
DS723_REPO=/volume1/docker/ifg_v2/ifg_standalone
DS723_ENV_FILE=/volume1/docker/ifg_v2/ifg_standalone/.env.production
DS723_COMPOSE_FILE=docker/docker-compose.prod.yml
DS723_DOCKER_PATH=/var/packages/ContainerManager/target/usr/bin
DS723_REMOTE_RSYNC_PATH=/bin/rsync
DS723_DEPLOY_BRANCH=production
